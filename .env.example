# GRC MCP Server Configuration
#
# Quick Start:
#   - For minimal setup (on-premises or IBM Cloud HOSTED): Use .env.example.minimal.basic
#   - For minimal setup (IBM Cloud SaaS, MCSP, or CP4D): Use .env.example.minimal.bearer
#   - For detailed comments: See .env.example.full
#   - For comprehensive docs: See docs/CONFIGURATION_DEFAULTS.md

# ============================================================================
# MANDATORY SETTINGS
# ============================================================================

# Root URL of the OpenPages server. Include any context path that precedes /opgrc/api/v2/...
# Examples:
#   https://your-openpages-instance.com          → API at <url>/opgrc/api/v2/...  (most on-prem / IBM Cloud SaaS)
#   https://host/openpages                        → API at <url>/opgrc/api/v2/...  (context-rooted instances)
# TIP: if your API URL is https://host/openpages/opgrc/api/v2/..., set OPENPAGES_BASE_URL=https://host/openpages
#      if your API URL is https://host/opgrc/api/v2/...,           set OPENPAGES_BASE_URL=https://host
OPENPAGES_BASE_URL=https://your-openpages-instance.com
# [OPTIONAL] Override the prefix that is inserted between OPENPAGES_BASE_URL and /api/v2/...
# Default: /opgrc  (i.e. <base_url>/opgrc/api/v2/...)
# Set this only when your server uses a non-standard prefix, e.g.:
#   OPENPAGES_API_ROOT=/openpages/opgrc   → full URL becomes <base_url>/openpages/opgrc/api/v2/...
# Leave empty to use the auto-detected default.
OPENPAGES_API_ROOT=
OPENPAGES_AUTHENTICATION_TYPE=bearer

# Basic Auth (required if OPENPAGES_AUTHENTICATION_TYPE=basic)
OPENPAGES_USERNAME=
OPENPAGES_PASSWORD=

# Bearer Auth (required if OPENPAGES_AUTHENTICATION_TYPE=bearer)
OPENPAGES_AUTHENTICATION_URL=
OPENPAGES_APIKEY=

# CP4D (required for CP4D deployments)
OPENPAGES_INSTANCE_NAME=

# OIDC / Keycloak (required if AUTHENTICATION_URL points to /protocol/openid-connect/token)
# Use OPENPAGES_USERNAME + OPENPAGES_PASSWORD for password grant (most common)
# Optionally also set client_id/client_secret if required by the Keycloak realm
OPENPAGES_OIDC_CLIENT_ID=
OPENPAGES_OIDC_CLIENT_SECRET=

# Cookie auth (required if OPENPAGES_AUTHENTICATION_TYPE=cookie)
#
# Option A — Auto-login via the built-in form login (standard OpenPages instances):
#   Set OPENPAGES_USERNAME + OPENPAGES_PASSWORD; the server will log in automatically
#   at startup and refresh the session whenever it expires.
#
# Option B — Pre-obtained browser cookies (instances with external OIDC/SSO like Keycloak):
#   The form-login path may not grant REST API access if WebSEAL restricts /opgrc/ to
#   OIDC-authenticated sessions only. In that case you must supply the cookies manually:
#   1. Log in to OpenPages via your browser (completing the SSO redirect).
#   2. Open DevTools → Network → click any /opgrc/ API request.
#   3. Copy the full "Cookie:" request header value and paste it below.
#   Key cookies needed: OPJSESSIONID, OPToken, OP-XSRF-TOKEN
OPENPAGES_SESSION_COOKIES=

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Server
APP_NAME=grc-mcp-server
DEBUG=false
SERVER_MODE=remote
HOST=0.0.0.0
PORT=8000

# SSL
SSL_VERIFY=true

# HTTP
HTTP_MAX_CONNECTIONS=20

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/grc-mcp.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Observability
OBSERVABILITY_ENABLED=false
METRICS_ENABLED=false
TRACING_ENABLED=false
OTLP_ENDPOINT=
CONSOLE_TRACING=false

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# Object Types
OBJECT_TYPES_CONFIG_PATH=src/app/config/object_types.json

# Authentication
AUTH_ENABLED=true

# Currency
DEFAULT_CURRENCY=USD

# Schema Caching
SCHEMA_CACHE_MAX_SIZE=20
SCHEMA_CACHE_TTL=3600
ENABLE_MINIMAL_SCHEMA_MODE=true
CACHE_QUERY_EXAMPLES=true

# MCP Sessions
MCP_SESSION_ENFORCEMENT=false
MCP_SESSION_TTL=3600
MCP_SESSION_MAX_COUNT=1000
MCP_SESSION_CLEANUP_INTERVAL=300
